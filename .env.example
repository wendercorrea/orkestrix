# Copie para .env e troque TODOS os valores. O compose recusa subir sem eles.
# Nunca versione o .env.

# Senha do PostgreSQL (criada na primeira subida; depois de criado o banco, trocar aqui não troca a senha dele).
POSTGRES_PASSWORD=troque-esta-senha-do-banco

# Segredo do login JWT: 32 ou mais caracteres aleatórios.
ORKESTRIX_JWT_SECRET=troque-por-um-segredo-aleatorio-com-32-ou-mais-caracteres

# Senha do usuário admin (criado na primeira subida).
ADMIN_PASSWORD=troque-a-senha-do-admin

# Chave-mestra do cofre de segredos. NUNCA troque depois: com outra chave, os segredos gravados deixam de abrir.
ORKX_SECRETS_KEY=troque-esta-chave-mestra-do-cofre

# API Gateway. Os dois com 32 ou mais caracteres aleatórios (ex.: openssl rand -base64 36), cada um com valor próprio.
# Pepper das chaves de API: NUNCA troque depois, senão todas as chaves já emitidas deixam de valer.
ORKX_GW_API_KEY_PEPPER=troque-por-um-segredo-aleatorio-com-32-ou-mais-caracteres
# Token da Management API (o backend e o gateway usam o mesmo; é o que liga o «Publicar no API Gateway» do designer).
ORKX_GW_MANAGEMENT_TOKEN=troque-por-outro-token-aleatorio-com-32-ou-mais-caracteres

# Opcionais
#ORKESTRIX_VERSION=4.1.15     # versão das imagens do Docker Hub
#HTTP_PORT=8080              # porta do site
#POSTGRES_PORT=5432          # porta do banco no seu computador (mude se a 5432 já estiver em uso)
#POSTGRES_BIND=127.0.0.1     # quem acessa o banco: 127.0.0.1 = só este computador; 0.0.0.0 = toda a rede
#POSTGRES_DB=orkestrix       # nome do banco (só vale na primeira subida)
#POSTGRES_USER=orkestrix     # usuário do banco (só vale na primeira subida)
#GATEWAY_PORT=8090           # porta pública do gateway
#ORKX_GW_PUBLIC_URL=         # endereço público do gateway (ex.: https://api.suaempresa.com.br), só para o exemplo curl do designer
#ORKX_GW_MAX_RESULT_SIZE=2MB # maior resposta do Orkestrix que o gateway lê (256KB a 64MB); aumente se uma API devolve muitas linhas

# Limites de tamanho (desde a 4.1.9; sem a variável vale o padrão ao lado, o valor de sempre). Tamanhos aceitam KB, MB e GB.
#ORKX_MAX_BODY_SIZE=1m              # maior corpo de requisição aceito pela tela (publicar ou importar um BPMN grande); é do nginx: 512k, 20m, 1g (0 = sem limite)
#ORKX_FILE_MAX_READ_SIZE=5MB        # maior arquivo que o conector «file» lê (o conteúdo vira variável do processo)
#ORKX_SPREADSHEET_MAX_ROWS=2000000  # linhas que o conector «spreadsheet» lê por nó quando o nó não informa «maxRows»
#ORKX_SPREADSHEET_COLLECT_MAX_ROWS=500000  # idem, quando o nó entrega as linhas ao próximo passo (collect); ficam na memória
#ORKX_TRANSFORM_MAX_ROWS=500000  # linhas por etapa do «Mapear e transformar» quando o nó não informa «maxRows»; ficam na memória do processo
#ORKX_REST_PREVIEW_MAX_SIZE=1MB     # maior resposta que o «Enviar» da chamada REST lê no editor (até 64MB); acima disso a resposta aparece cortada

# Variáveis grandes de processo (desde a 4.1.9)
#ORKX_VARIABLE_INLINE_MAX_CHARS=65536  # acima disto o valor de uma variável vai para tabela própria e a instância guarda só a referência (0 desliga)
#ORKX_VARIABLE_WARN_CHARS=5000000      # o log avisa quando uma variável passa disto (0 não avisa)

# Retenção de dados (desde a 4.1.10)
#ORKX_RETENTION_INSTANCES_DAYS=0       # apaga instâncias terminadas (concluídas, com falha ou canceladas) há mais de N dias, com histórico, logs, tarefas e variáveis. 0 = nunca apaga. Faça backup antes de ligar: o que sai não volta
